<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One Big Sheet: prices, the sheet and the order go to the print relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The painting's touch (ui/paint/Haptics.kt): no prompt, a normal permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MoonlightApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Moonlight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A painting someone sent, a .moonlight file (data/SharedPaintings.kt): by its own
                 type, sent from Android; as application/octet-stream, the type a file from the
                 iOS app (which declares none) or an unknown extension arrives as, opened only if
                 its bytes are a painting's; and by its name where a file manager gives one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.paintbymoonlight.painting" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.moonlight" />
                <data android:pathPattern=".*\\..*\\.moonlight" />
                <data android:pathPattern=".*\\..*\\..*\\.moonlight" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Painting in Progress, the home-screen widget (outside/PaintingWidget.kt). -->
        <receiver
            android:name=".outside.PaintingWidgetReceiver"
            android:exported="true"
            android:label="Painting in Progress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/painting_widget_info" />
        </receiver>
        <!-- ML Kit's models (core/Findings.kt), downloaded by Play services when the app installs. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face,ocr,subject_segment" />
        <!-- Google Pay for One Big Sheet (print/GooglePay.kt). -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />
        <provider
            android:name=".data.MoonlightFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
